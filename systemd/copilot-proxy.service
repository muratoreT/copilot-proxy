[Unit]
Description=Copilot Proxy - OpenAI-compatible reverse proxy for a local AI server
Wants=network-online.target
After=network-online.target
ConditionFileNotEmpty=/home/ubuntuai/copilot-proxy/config.yaml

[Service]
Type=simple
User=ubuntuai
Group=ubuntuai
WorkingDirectory=/home/ubuntuai/copilot-proxy
ExecStart=/home/ubuntuai/copilot-proxy/venv/bin/python /home/ubuntuai/copilot-proxy/proxy_entry.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=copilot-proxy

# Environment
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntuai/copilot-proxy/logs
PrivateTmp=true

[Install]
WantedBy=multi-user.target
